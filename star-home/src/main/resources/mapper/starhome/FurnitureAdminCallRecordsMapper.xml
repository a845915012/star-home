<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.starhome.mapper.admin.FurnitureAdminCallRecordsMapper">

    <select id="selectPageWithUserAndModule" resultType="com.ruoyi.starhome.domain.vo.FurnitureAiCallRecordsVO">
        SELECT r.*,
               u.user_name AS userName,
               u.phonenumber
        FROM furniture_ai_call_records r
        LEFT JOIN sys_user u ON r.user_id = u.user_id
        <where>
            <if test="module != null and module != ''">
                AND r.module = #{module}
            </if>
            <if test="username != null and username != ''">
                AND u.user_name LIKE CONCAT('%', #{username}, '%')
            </if>
        </where>
        ORDER BY r.id DESC
    </select>

</mapper>
